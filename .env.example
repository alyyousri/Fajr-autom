# انسخه لـ .env للتشغيل المحلي (وماترفعش .env على GitHub)
MOODLE_URL=https://learn.fajr.com
MOODLE_TOKEN=
BREVO_API_KEY=

# Odoo (لا توجد قيم افتراضية داخل الكود)
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
# كلمة المرور، أو الأفضل API key من إعدادات مستخدم الربط في Odoo
ODOO_PASSWORD=

# إلزامي: بدونه الـ webhook بيرفض كل الطلبات.
# يتبعت في الهيدر X-Webhook-Token (ولد قيمة عشوائية طويلة، مثلا: python -c "import secrets; print(secrets.token_urlsafe(32))")
WEBHOOK_SECRET=

# ===== اختياري (القيم الافتراضية في التعليق) =====
# BIRTH_DATE_ORDER=dmy            # أو mdy لو الفورم بتبعت شهر/يوم/سنة
# FORCE_PASSWORD_CHANGE=true      # إجبار الطالب على تغيير كلمة المرور عند أول دخول
# MOODLE_COURSE_ID=20             # كورس تحديد المستوى
# MOODLE_GROUP_MALE=2
# MOODLE_GROUP_FEMALE=1
# ODOO_CATEGORY_ID=40             # Online Group
# ODOO_PRICELIST_ID=75            # Group OnLine
# ODOO_BRANCH_ID=548              # راجع إنه فرع الـ Online
# ODOO_STUDENT_CODE_FIELD=name_seq
# REQUEST_TIMEOUT=20
# ODOO_TIMEOUT=30
# LOG_LEVEL=INFO
